PORT=8080
HOST_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# Caddy / Automatic TLS
DOMAIN=
ACME_EMAIL=
GATEWAY_UPSTREAM=gateway:8080

# Docker Image
DOCKER_IMAGE=cristiandulcey/wompi-gateway
IMAGE_TAG=latest

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=disable
DATABASE_URL=

# Gateway Security & Worker Tuning
ADMIN_API_KEY=
AUTO_MIGRATE=true
WORKER_CONCURRENCY=8
WORKER_POLL_INTERVAL=5s
HTTP_FORWARD_TIMEOUT=15s
GIN_MODE=release
